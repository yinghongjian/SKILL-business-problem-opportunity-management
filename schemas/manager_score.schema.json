{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManagerScore",
  "type": "object",
  "additionalProperties": false,
  "required": ["score_id", "owner_id", "owner_name", "period_start", "period_end", "total_score", "rank", "representative_cases", "needs_human_review"],
  "properties": {
    "score_id": { "type": "string" },
    "owner_id": { "type": "string" },
    "owner_name": { "type": "string" },
    "department": { "type": ["string", "null"] },
    "period_start": { "type": "string", "format": "date" },
    "period_end": { "type": "string", "format": "date" },
    "problem_discovery_score": { "type": "number", "minimum": 0 },
    "opportunity_discovery_score": { "type": "number", "minimum": 0 },
    "solution_quality_score": { "type": "number", "minimum": 0 },
    "achievement_score": { "type": "number", "minimum": 0 },
    "review_learning_score": { "type": "number", "minimum": 0 },
    "total_score": { "type": "number", "minimum": 0 },
    "rank": { "type": "integer", "minimum": 1 },
    "ranking_bucket": {
      "type": "string",
      "enum": ["overall", "best_problem_discoverer", "best_opportunity_discoverer", "best_solution", "best_achievement"]
    },
    "representative_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_type", "title", "evidence_ref"],
        "properties": {
          "case_type": { "type": "string", "enum": ["problem", "opportunity", "solution", "achievement", "review"] },
          "title": { "type": "string" },
          "evidence_ref": { "type": "string" },
          "value_level": { "type": ["string", "null"], "enum": ["S", "A", "B", "C", null] }
        }
      },
      "minItems": 1
    },
    "public_summary": { "type": ["string", "null"] },
    "private_notes": { "type": ["string", "null"] },
    "data_completeness": { "type": "string", "enum": ["complete", "partial", "insufficient"], "default": "partial" },
    "needs_human_review": { "type": "boolean" }
  }
}
