{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BusinessProblem",
  "type": "object",
  "additionalProperties": false,
  "required": ["problem_id", "source_report_id", "summary", "source_text", "business_module", "value_level", "urgency_level", "status", "needs_human_review"],
  "properties": {
    "problem_id": { "type": "string" },
    "source_report_id": { "type": "string" },
    "owner_id": { "type": ["string", "null"] },
    "owner_name": { "type": ["string", "null"] },
    "item_type": { "type": "string", "enum": ["problem", "risk"], "default": "problem" },
    "summary": { "type": "string" },
    "source_text": { "type": "string" },
    "business_module": {
      "type": "string",
      "enum": ["商品", "渠道", "库存", "视觉", "客服", "供应链", "财务", "投放", "直播", "组织协同", "其他"]
    },
    "platform": { "type": ["string", "null"] },
    "category": { "type": ["string", "null"] },
    "sku_code": { "type": ["string", "null"] },
    "impact_metrics": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "evidence_strength": { "type": "string", "enum": ["strong", "medium", "weak"], "default": "weak" },
    "value_level": { "type": "string", "enum": ["S", "A", "B", "C"] },
    "urgency_level": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "rating_reason": { "type": "string" },
    "suggested_action": { "type": ["string", "null"] },
    "responsible_department": { "type": ["string", "null"] },
    "responsible_person": { "type": ["string", "null"] },
    "deadline": { "type": ["string", "null"], "format": "date" },
    "need_boss": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "delayed", "closed"] },
    "needs_human_review": { "type": "boolean" },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
